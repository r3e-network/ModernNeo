    <ProjectReference Include="..\..\src\Neo.Ledger\Neo.Ledger.csproj" />
    <ProjectReference Include="..\..\src\Neo.Network\Neo.Network.csproj" />
    <ProjectReference Include="..\..\src\Neo.Node.Core\Neo.Node.Core.csproj" />
    <ProjectReference Include="..\..\src\Neo.Plugins\Neo.Plugins.csproj" />
