<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Neo.Ledger.Abstractions</AssemblyName>
    <RootNamespace>Neo.Ledger.Abstractions</RootNamespace>
    <PackageTags>NEO;Blockchain;Ledger;Abstractions</PackageTags>
    <Description>Ledger abstraction interfaces for Neo blockchain</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only depends on Neo.Core.Abstractions - maintains layered architecture -->
    <ProjectReference Include="..\Neo.Core.Abstractions\Neo.Core.Abstractions.csproj" />
  </ItemGroup>

</Project>
