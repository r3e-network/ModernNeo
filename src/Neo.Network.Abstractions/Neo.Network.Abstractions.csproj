<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Neo.Network.Abstractions</AssemblyName>
    <RootNamespace>Neo.Network.Abstractions</RootNamespace>
    <PackageTags>NEO;Blockchain;Network;Abstractions</PackageTags>
    <Description>Network abstraction interfaces for Neo blockchain P2P layer</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only depends on Neo.Core.Abstractions - maintains layered architecture -->
    <ProjectReference Include="../Neo.Core.Abstractions/Neo.Core.Abstractions.csproj" />
  </ItemGroup>

</Project>
