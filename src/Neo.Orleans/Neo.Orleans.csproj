<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Neo.Orleans</RootNamespace>
    <!-- Suppress XML doc warnings for Orleans-generated code -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="8.2.0" />
    <PackageReference Include="Microsoft.Orleans.Persistence.Memory" Version="8.2.0" />
    <PackageReference Include="MessagePack" Version="3.0.3" NoWarn="NU1902" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo\Neo.csproj" />
    <ProjectReference Include="..\Neo.Core\Neo.Core.csproj" />
    <ProjectReference Include="..\Neo.IO\Neo.IO.csproj" />
    <ProjectReference Include="..\Neo.Protocol\Neo.Protocol.csproj" />
    <ProjectReference Include="..\Neo.Protocol.Payloads\Neo.Protocol.Payloads.csproj" />
    <ProjectReference Include="..\Neo.Serialization.MessagePack\Neo.Serialization.MessagePack.csproj" />
    <ProjectReference Include="..\Neo.Storage\Neo.Storage.csproj" />
  </ItemGroup>

</Project>
